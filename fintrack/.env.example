SPRING_PROFILES_ACTIVE=prod
PORT=9090
# Prefer SPRING_DATASOURCE_URL for providers that supply a complete JDBC URL.
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:3306/DATABASE?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION=86400000
FRONTEND_ORIGIN=https://your-frontend.onrender.com
